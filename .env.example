# Copy to .env and fill in. .env is gitignored: these are YOUR credentials and YOUR bill.
# The default backend (claude-subagents) needs NOTHING in this file. Leave it empty until
# you deliberately move to a metered backend.

# --- openrouter-panel backend only ---
# OPENROUTER_API_KEY=

# Space-separated roster. Verify every slug against OpenRouter's live model list before
# a run: slugs get renamed and retired without notice, and a bad slug fails that seat silently.
# PANEL_MODELS="openrouter/<vendor>/<model-a> openrouter/<vendor>/<model-b> openrouter/<vendor>/<model-c>"

# The verifier NEVER sits as a panelist.
# VERIFIER_MODEL="openrouter/<vendor>/<model-v>"

# CLI runner, if yours is not named `opencode`
# PANEL_CLI=opencode
